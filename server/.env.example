# ============================================================
# Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

APP_ENV=development
PORT=8080

# ── MySQL ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password_here         # REQUIRED — no default
DB_DATABASE=coffee_saas
DB_PORT=3306

# ── MySQL Production (only when APP_ENV=production) ───────────
# DB_PROD_HOST=
# DB_PROD_USER=
# DB_PROD_PASSWORD=
# DB_PROD_DATABASE=
# DB_PROD_PORT=3306

# ── Redis ─────────────────────────────────────────────────────
# Local dev: leave blank (falls back to 127.0.0.1:6379)
# REDIS_URL=redis://default:password@host:6379

# ── JWT (REQUIRED — must be long random strings) ──────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_KEY=REPLACE_WITH_64_BYTE_RANDOM_HEX
REFRESH_TOKEN_KEY=REPLACE_WITH_64_BYTE_RANDOM_HEX

# ── CORS (comma-separated list of allowed frontend origins) ───
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CLIENT_URL=http://localhost:5173

# ── Platform Telegram Notifications (C-1 fix) ─────────────────
# These are for platform-level login alerts only.
# Never hardcode a token in source code.
PLATFORM_TELEGRAM_TOKEN=
PLATFORM_TELEGRAM_CHAT_ID=

# ── Cloudinary (Optional — for image uploads) ─────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email — Brevo API (Optional) ──────────────────────────────
BREVO_API_KEY=
PLATFORM_SENDER_EMAIL=noreply@yourdomain.com

# ── PayWay / ABA Payment (Optional) ───────────────────────────
PAYWAY_MERCHANT_ID=demo_merchant
PAYWAY_API_KEY=demo_api_key
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments
PAYWAY_CALLBACK_URL=http://localhost:8080/api/payment/callback
PAYWAY_RETURN_URL=http://localhost:5173/payment/result

# ── Flutter App Secret (Optional) ─────────────────────────────
FLUTTER_SECRET_KEY=

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
