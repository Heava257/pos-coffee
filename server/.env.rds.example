# =========================================================================
#  PRODUCTION ENVIRONMENT VARIABLES FOR AWS RDS & DECOUPLED DEPLOYMENT
# =========================================================================

# 1. SERVER CONFIGURATION
PORT=8080
APP_ENV=production

# 2. AWS RDS DATABASE CONNECTION
DB_HOST=your-rds-endpoint.xxxx.us-east-1.rds.amazonaws.com
DB_USER=prod_user
DB_PASSWORD=your_secure_rds_password
DB_DATABASE=coffee_saas
DB_PORT=3306

# 3. REDIS CONFIGURATION (EC2 Container)
REDISHOST=redis
REDISPORT=6379
# REDISPASSWORD=

# 4. JWT SECURITY KEYS (Generate 64-byte random strings in production)
ACCESS_TOKEN_KEY=saas_hub_secret_key_2024_replace_with_64byte_random_string_in_production
REFRESH_TOKEN_KEY=pos_nit_refresh_secret_2024_replace_with_64byte_random_string_in_production

# 5. SMTP/EMAIL CONFIGURATION (Brevo HTTP API Bypass)
SMTP_USER=your_brevo_smtp_user
SMTP_PASS=your_brevo_smtp_password
BREVO_API_KEY=your_brevo_api_key
SENDER_EMAIL=your_sender_email

# 6. IMAGE STORAGE (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 7. PLATFORM ORIGINS & REDIRECTS (Update with your Vercel/S3 frontend URL)
CLIENT_URL=https://your-vercel-app.vercel.app
ALLOWED_ORIGINS=https://your-vercel-app.vercel.app,http://localhost:5173,http://localhost:3000
APP_URL=https://your-vercel-app.vercel.app
VITE_PLATFORM_API_URL=http://localhost:3000/api
VITE_PLATFORM_HUB_URL=http://localhost:3000
PAYWAY_RETURN_URL=https://your-vercel-app.vercel.app/payment/result
